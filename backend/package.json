{
  "name": "prodify-ai-coach-backend",
  "version": "1.0.0",
  "description": "Backend for Prodify AI Coach - authentication, progress tracking and task management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'No build step required for Node.js'",
    "seed:topics": "node seed/runSeed.js",
    "seed:problems": "node seedProblemBank.js",
    "seed:todays-problems": "node seedTodaysProblemBank.js",
    "fix:duplicate-progress": "node scripts/fixDuplicateProgress.js",
    "smoke-test": "node scripts/smokeTest.js",
    "update-db-password": "node scripts/updateDbPassword.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "authentication",
    "task-management"
  ],
  "author": "Prodify AI Coach",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": "24.x"
  }
}
