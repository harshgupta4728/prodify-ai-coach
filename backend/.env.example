# Copy this file to backend/.env and fill in the values.
# backend/.env is git-ignored: never commit it, and never put these values in the frontend.
# In production, set the same variables in the Render dashboard (Environment tab).

# ---- Required ----

# MongoDB Atlas connection string. Put a database name in it: the live site uses "test",
# local development should use its own (for example "prodify_dev").
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Signs login tokens; anyone who knows it can log in as any user. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Email (needed in production) ----
# Without BREVO_API_KEY, local development prints emails (including OTP codes) in the backend terminal
# instead of sending them. In production, emails fail until it is set.

BREVO_API_KEY=
# Sender address; must be a verified sender in Brevo (default: harshgupta4728@gmail.com)
EMAIL_USER=

# ---- Optional ----

# Set to "production" on Render
NODE_ENV=development
PORT=10000

# Comma-separated emails of accounts that can open the admin panel and edit topics, MCQs and interview questions
ADMIN_EMAILS=

# Comma-separated frontend URLs allowed to call the API.
# Default: localhost:8080/5173 in development, https://prodify-ai-coach-frontend.onrender.com in production
CLIENT_ORIGINS=

# Number of proxies between users and the server in production (default 1). See RENDER_DEPLOYMENT.md.
TRUST_PROXY=

# Judge0 key (RapidAPI) for the code runner. Without it, the free Wandbox service is used.
JUDGE0_API_KEY=
